# Context7 MCP API key. Referenced by .mcp.json as ${CONTEXT7_API_KEY}.
# Claude Code does NOT auto-load .env, so export this into the shell that
# launches `claude` (e.g. source .env, direnv, or your shell profile).
CONTEXT7_API_KEY="ctx7sk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- POST /api/contact (FR-7). Without these the route returns the §8 500. ---

# Server-side only. NEVER prefix with NEXT_PUBLIC_ (§9.4) — that ships the key
# in the client bundle and anyone can send mail as you.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# ⚠️ `onboarding@resend.dev` is Resend's sandbox sender and it will ONLY deliver
# to the address that owns the Resend account. Every recruiter's copy is rejected
# with a 403, which fails G-4 silently. Verify a domain at resend.com/domains and
# set this to an address on it before launch.
EMAIL_FROM="onboarding@resend.dev"

# Optional. Where the lead notification (Email B) goes. Defaults to profile.email
# in src/content/profile.ts, which is correct in production; override it to test a
# preview deployment without mailing the real inbox.
# EMAIL_TO="you@example.com"
