# Context7 MCP API key. Referenced by .mcp.json as ${CONTEXT7_API_KEY}.
# Claude Code does NOT auto-load .env, so export this into the shell that
# launches `claude` (e.g. source .env, direnv, or your shell profile).
CONTEXT7_API_KEY="ctx7sk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- POST /api/contact (FR-7). Without these the route returns the §8 500. ---

# Server-side only. NEVER prefix with NEXT_PUBLIC_ (§9.4) — that ships the key
# in the client bundle and anyone can send mail as you.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# ⚠️ `onboarding@resend.dev` is Resend's sandbox sender and it will ONLY deliver
# to the address that owns the Resend account. Every recruiter's copy is rejected
# with a 403, which fails G-4 silently. Verify a domain at resend.com/domains and
# set this to an address on it before launch.
EMAIL_FROM="onboarding@resend.dev"

# Optional. Where the lead notification (Email B) goes. Defaults to profile.email
# in src/content/profile.ts, which is correct in production; override it to test a
# preview deployment without mailing the real inbox.
# EMAIL_TO="you@example.com"

# --- Cloudflare Turnstile (§8's 403). Without these the route rejects EVERY ---
# --- submission with a 403. All three fail closed by design — see the note in ---
# --- src/app/api/contact/route.ts. ---

# Public by design: it is embedded in the page and identifies the widget, not you.
# The NEXT_PUBLIC_ prefix is required — without it the value is undefined in the
# browser, the widget never renders, and every submission 403s with no visible cause.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAE5mCjF_G1_wRd6g"

# ⚠️ Server-side only. NEVER prefix with NEXT_PUBLIC_ (§9.4) — that ships the key in
# the client bundle and anyone can mint verifications against your widget. Retrieve it
# from the Turnstile dashboard; it must never reach a commit, a log, or a diff.
TURNSTILE_SECRET_KEY="0x4AAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Comma-separated. The hostnames a Turnstile token may have been solved on, compared
# against siteverify's returned `hostname`.
#
# ⚠️ DEPLOYMENT-SPECIFIC, and this is the whole point of it. One widget is registered
# for both local and production domains, so this variable is what stops a token solved
# on localhost from being spent against production. Local uses the line below;
# PRODUCTION MUST BE "www.dasigr.com,dasigr.com" AND MUST NOT CONTAIN localhost.
#
# An empty or unset value accepts NOTHING rather than everything — a missing gate and
# a misconfigured one must not look the same to the route.
TURNSTILE_HOSTNAMES="localhost"
